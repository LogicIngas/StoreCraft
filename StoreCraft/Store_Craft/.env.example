# =============================================================================
# BACKEND ENVIRONMENT VARIABLES — EXAMPLE FILE
# Copy this to .env and fill in your real values. DO NOT commit .env
# =============================================================================

# --- Supabase PostgreSQL Database (Transaction Pooler - Port 6543) ---
# Get from: Supabase Dashboard > Project Settings > Database > Connection Pooling
DB_URL=jdbc:postgresql://YOUR_PROJECT.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Server ---
SERVER_PORT=8080

# --- CORS: comma-separated list of allowed frontend origins ---
FRONTEND_URL=http://localhost:5173

# --- JWT (generate a strong Base64-encoded 256-bit secret) ---
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY

# --- Email (optional — app still starts without these) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password

# --- Cloudinary (persistent image storage — get from cloudinary.com > Dashboard) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
