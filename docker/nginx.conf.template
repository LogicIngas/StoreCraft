# =============================================================================
# nginx front end for the StoreCraft container.
#
#   /assets, /favicon.svg, ...  -> the built React SPA
#   /product, /api, /ws, ...    -> proxied to the Spring Boot JVM
#
# Because both live behind one hostname the browser makes same-origin requests
# only, so CORS is bypassed entirely and no origin list has to be maintained.
#
# The listen port and the upstream API port are placeholders substituted by
# docker/start.sh at boot.
# =============================================================================

user  root;
worker_processes  auto;

error_log  /var/log/nginx/error.log  warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Required so SockJS/Stomp endpoints on /ws and /chat can be upgraded.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Render terminates TLS before this container, so the incoming
    # X-Forwarded-Proto is the client's real scheme and must be preserved.
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    server_tokens   off;

    # Larger than spring.servlet.multipart.max-file-size (10MB) so the JVM, not
    # nginx, is the component that reports an oversized upload.
    client_max_body_size  20m;
    client_body_timeout   120s;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain
                      text/css
                      text/javascript
                      application/javascript
                      application/json
                      application/xml
                      image/svg+xml;

    upstream backend {
        server 127.0.0.1:__BACKEND_PORT__;
        keepalive 32;
    }

    server {
        # IPv4 only on purpose. Render has no IPv6, and binding [::] fails
        # outright in a container whose network namespace has IPv6 disabled,
        # which would stop nginx from starting at all.
        listen      __PORT__;
        server_name _;

        root  /usr/share/nginx/html;
        index index.html;

        # Referenced by the Dockerfile HEALTHCHECK.
        location = /nginx-health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "ok\n";
        }

        # Vite emits content-hashed filenames, so these are safe to cache hard.
        location /assets/ {
            expires    1y;
            add_header Cache-Control "public, immutable";
            try_files  $uri =404;
        }

        # Backend routes. Keep in sync with the list in
        # StoreCraft/Store_Craft/frontend/vite.config.js used for local dev.
        location ~ ^/(user|product|cart|order|payment|address|coupon|review|admin|api|chat|ws|images|uploads|actuator)(/|$) {
            proxy_pass         http://backend;
            proxy_http_version 1.1;

            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host  $host;
            proxy_set_header X-Forwarded-Port  $server_port;

            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # SockJS long-polling and WebSocket sessions must not time out.
            proxy_read_timeout  3600s;
            proxy_send_timeout  3600s;
            proxy_buffering     off;
        }

        # Everything else is the SPA. The app currently navigates through
        # component state rather than the history API, but the fallback keeps
        # direct visits and future routes working.
        location / {
            add_header Cache-Control "no-cache";
            try_files $uri $uri/ /index.html;
        }
    }
}
