# ============================================================================
# ENVIRONMENT VARIABLES FOR E-MARKETPLACE APPLICATION
# ============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=logindb
DB_USERNAME=root
DB_PASSWORD=password

# File Upload
FILE_UPLOAD_DIR=uploads
MAX_FILE_SIZE=10MB

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Payment Gateway
PAYMENT_GATEWAY_MOCK_ENABLED=true
PAYMENT_GATEWAY_MOCK_DELAY_MS=1000
PAYMENT_TIMEOUT_MINUTES=10

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# Application
APP_NAME=E-Marketplace
APP_VERSION=1.0.0